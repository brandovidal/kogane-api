{
  "name": "kogane-api",
  "version": "0.0.1",
  "description": "Kogane API: expense intake from chat with AI",
  "author": "Brando Vidal",
  "private": true,
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "dotenv -e .env.dev -- nest start --watch",
    "qa": "dotenv -e .env.qa -- nest start --watch",
    "build": "nest build",
    "start:prod": "node dist/main",
    "lint": "eslint \"src/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.ts\"",
    "test:ci": "dotenv -e .env.test -- vitest run --project unit",
    "test:integration": "dotenv -e .env.test -- vitest run --project integration",
    "postinstall": "prisma generate",
    "prepare": "husky"
  },
  "dependencies": {
    "@google/genai": "2.23.0",
    "@libsql/client": "^0.17.4",
    "@nestjs/common": "^11.2.5",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.5",
    "@nestjs/platform-express": "^11.2.5",
    "@nestjs/swagger": "^11.4.7",
    "@prisma/adapter-libsql": "7.10.0",
    "@prisma/client": "7.10.0",
    "aws4fetch": "^1.0.20",
    "bullmq": "^5.81.5",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "fflate": "^0.8.3",
    "ioredis": "^5.11.1",
    "nestjs-pino": "^5.2.0",
    "nestjs-zod": "^5.5.0",
    "nodemailer": "^10.0.10",
    "openai": "7.21.0",
    "pdfjs-dist": "^5.7.284",
    "pdfkit": "^0.20.2",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tesseract.js": "^6.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.5",
    "@swc/core": "^1.16.2",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.4",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.6",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "4.1.11",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "knip": "6.35.1",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.8",
    "prisma": "7.10.0",
    "supertest": "^7.2.2",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.70.1",
    "unplugin-swc": "^2.0.0",
    "vitest": "^4.1.11"
  }
}
