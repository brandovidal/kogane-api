// Data model: sections 2 and 8 of personal/docs/plans/2026-09-22-gastos-bot-ai-design.md
// SQLite/libSQL has no native enums: string columns are validated with the enums in
// src/commons/constants/*.constant.ts.
// Table prefixes by use: cat_ catalogs · bud_ budget · exp_ expenses · bot_ chat bot · ntf_ notifications · ai_ AI usage ·
// imp_ imports (P14)

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  // Without it the extension is inferred from tsconfig.json, which the Docker install step does not have yet:
  // the image then imports "./internal/class.ts" and crashes on start (P10, 2026-09-23)
  importFileExtension = ""
}

datasource db {
  provider = "sqlite"
}

// ==================== CATALOGS (cat_) ====================

model Person {
  id             String   @id @default(cuid())
  userId         String? // whose row it is (P23, D82): set and filtered by the tenancy extension
  name           String
  aliases        String   @default("[]") // JSON array of lowercase aliases used by the AI
  isActive       Boolean  @default(true)
  isDefault      Boolean  @default(false) // the owner: used when a message does not say who the expense is for
  documentNumber String? // DNI: the password of the bank statement PDFs (D94); never sent to the AI nor logged
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  expenseDrafts ExpenseDraft[]

  dailyExpenses      DailyExpense[]
  fixedCosts         FixedCost[]
  subscriptions      Subscription[]
  creditCardExpenses CreditCardExpense[]
  debts              Debt[]
  recurringExpenses  RecurringExpense[]
  cardHolders        CardHolder[]
  commitments        Commitment[]

  @@unique([userId, name])
  @@index([userId])
  @@map("cat_people")
}

// Every way of paying. A credit card is a payment method of type credit_card with its billing days.
model PaymentMethod {
  id                   String   @id @default(cuid())
  userId               String? // whose row it is (P23, D82): set and filtered by the tenancy extension
  name                 String
  type                 String // PaymentMethodType
  code                 String? // short code of credit cards (CMR, OH, IO, AMEX)
  bank                 String? // debit cards require it (D107)
  network              String? // Visa, Mastercard, American Express, etc.
  currency             String? // preferred card currency (PEN or USD)
  creditLimit          Float?
  comment              String?
  aliases              String   @default("[]") // JSON array of lowercase aliases used by the AI
  isActive             Boolean  @default(true)
  showInBot            Boolean  @default(true) // offered as a quick reply button in the bot
  isPrimary            Boolean  @default(false) // the card of screenshots that do not show which one (D47): IO
  billingCloseDay      Int? // credit cards only
  paymentDueDay        Int? // credit cards only
  supportsAmortization Boolean  @default(false) // special debt payment available with this credit card (D114)
  supportsCashback     Boolean  @default(false) // statement cashback available with this credit card (D114)
  color                String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  expenseDrafts ExpenseDraft[]

  dailyExpenses      DailyExpense[]
  fixedCosts         FixedCost[]
  subscriptions      Subscription[]
  creditCardExpenses CreditCardExpense[]
  recurringExpenses  RecurringExpense[]
  debtPayments       DebtPayment[]
  debts              Debt[]              @relation("DebtCard")
  holders            CardHolder[]

  @@unique([userId, name])
  @@unique([userId, code])
  @@index([userId])
  @@map("cat_payment_methods")
}

// Who holds each credit card (P14, D116): the titular and the additional cards. A statement names them (CMR by section
// "<name> Tc: ******1810", Sip by its TIT/ADIC column) and each purchase goes to its person
model CardHolder {
  id              String        @id @default(cuid())
  userId          String? // whose row it is (P23, D82): set and filtered by the tenancy extension
  paymentMethodId String
  paymentMethod   PaymentMethod @relation(fields: [paymentMethodId], references: [id], onDelete: Cascade)
  personId        String
  person          Person        @relation(fields: [personId], references: [id], onDelete: Cascade)
  role            String // CardHolderRole: titular · additional
  last4           String? // last 4 digits of that person's card, as the statement prints them
  createdAt       DateTime      @default(now())

  @@unique([paymentMethodId, personId])
  @@index([userId])
  @@map("cat_card_holders")
}

model Category {
  id            String       @id @default(cuid())
  userId        String? // whose row it is (P23, D82): set and filtered by the tenancy extension
  name          String
  color         String       @default("#6B7280")
  icon          String?
  isDefault     Boolean      @default(false)
  budgetGroupId String?
  budgetGroup   BudgetGroup? @relation(fields: [budgetGroupId], references: [id])
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  budgets            CategoryBudget[]
  commitments        Commitment[]
  expenseDrafts      ExpenseDraft[]
  dailyExpenses      DailyExpense[]
  fixedCosts         FixedCost[]
  subscriptions      Subscription[]
  creditCardExpenses CreditCardExpense[]
  recurringExpenses  RecurringExpense[]

  @@unique([userId, name])
  @@index([budgetGroupId])
  @@index([userId])
  @@map("cat_categories")
}

// ==================== BUDGET (bud_) ====================

model BudgetGroup {
  id         String   @id @default(cuid())
  userId     String? // whose row it is (P23, D82): set and filtered by the tenancy extension
  name       String
  emoji      String   @default("📦")
  percentage Float    @default(0)
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  categories Category[]

  @@unique([userId, name])
  @@index([userId])
  @@map("bud_budget_groups")
}

model CategoryBudget {
  id             String   @id @default(cuid())
  userId         String? // whose row it is (P23, D82): set and filtered by the tenancy extension
  categoryId     String
  category       Category @relation(fields: [categoryId], references: [id])
  monthlyLimit   Float
  alertThreshold Float    @default(80)
  month          Int?
  year           Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([categoryId, month, year])
  @@index([userId])
  @@map("bud_category_budgets")
}

model MonthlyBudget {
  id           String   @id @default(cuid())
  userId       String? // whose row it is (P23, D82): set and filtered by the tenancy extension
  month        Int
  year         Int
  salary       Float
  limitPercent Float    @default(100)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, month, year])
  @@index([userId])
  @@map("bud_monthly_budgets")
}

// What counts in the budget besides fixed costs, cards and day to day (D96, D107): one row per user (P23).
// Subscriptions paid with a credit card never count here: the card charge already does (D46).
model BudgetSetting {
  id             String   @id @default(cuid())
  userId         String? // whose row it is (P23, D82): set and filtered by the tenancy extension
  recurringCount Boolean  @default(true) // Recurrentes (service, annual, other) add to the budget
  platformsCount Boolean  @default(false) // Plataformas add to the budget
  updatedAt      DateTime @updatedAt

  @@unique([userId])
  @@index([userId])
  @@map("bud_settings")
}

// Extra incomes of a month (P19, D65): the salary stays in bud_monthly_budgets; surplus = salary + extras − expenses
model Income {
  id          String   @id @default(cuid())
  userId      String? // whose row it is (P23, D82): set and filtered by the tenancy extension
  description String
  amount      Float
  currency    String   @default("PEN")
  receivedAt  DateTime
  month       Int
  year        Int
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([month, year])
  @@index([userId])
  @@map("bud_incomes")
}

// ==================== CHAT BOT (bot_) ====================

// Every expense received from a chat while the bot works on it: what the AI extracted, what is missing,
// what the bot asked (pendingField) and its status. The open draft of a chat is its conversation state.
// Saving it creates the record of its destination table (exp_daily_expenses, exp_fixed_costs…) linked by draftId.
model ExpenseDraft {
  id              String         @id @default(cuid())
  userId          String? // whose row it is (P23, D82): set and filtered by the tenancy extension
  channel         String // ExpenseDraftChannel
  chatId          String
  messageId       String
  itemIndex       Int            @default(0) // several expenses in the same message
  batchId         String? // screenshots answered with one list (P21): an album or an image with several expenses
  inputType       String // ExpenseDraftInputType
  documentType    String? // ExpenseDraftDocumentType
  rawText         String? // message text or audio transcription
  mediaFileId     String? // channel file id, the file itself is not stored
  mediaUniqueId   String? // stable id of the file in the channel (Telegram file_unique_id): same image sent again
  fileId          String? // the screenshot / voice note kept in R2 (D54, D58); several drafts can share one file
  file            StoredFile?    @relation(fields: [fileId], references: [id])
  status          String         @default("draft") // ExpenseDraftStatus
  pendingField    String? // what the bot is asking for
  destination     String? // ExpenseDestination
  description     String?
  amount          Float?
  currency        String?
  exchangeRate    Float?
  spentAt         DateTime?
  expenseType     String?
  installment     String?
  period          String?
  kind            String? // SubscriptionKind of a subscription; null = platform (D107)
  supplyNumber    String?
  merchant        String?
  operationNumber String?
  notes           String?
  personId        String?
  person          Person?        @relation(fields: [personId], references: [id])
  paymentMethodId String?
  paymentMethod   PaymentMethod? @relation(fields: [paymentMethodId], references: [id])
  categoryId      String?
  category        Category?      @relation(fields: [categoryId], references: [id])
  sharedWith      String? // JSON { shares: [{ personId, ratio?, amount? }] }: who owes a part of what the user paid (D73, D74)
  replacesDraftId String? // /editar (D76): this copy replaces the rows of that saved draft when it is saved
  shareMessageId  String? // the split message in the channel (D75): closed with its summary when the expense is saved
  confidence      String         @default("{}") // JSON { field: 0..1 }
  missingFields   String         @default("[]") // JSON [field]
  confirmedAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  dailyExpense      DailyExpense?
  fixedCost         FixedCost?
  subscription      Subscription?
  creditCardExpense CreditCardExpense?
  debt              Debt?
  aiRequests        AiRequestLog[]

  @@unique([userId, channel, chatId, messageId, itemIndex])
  @@index([channel, chatId, status])
  @@index([channel, chatId, mediaUniqueId])
  @@index([fileId])
  @@index([batchId])
  @@index([destination, status, spentAt])
  @@index([userId])
  @@map("bot_expense_drafts")
}

// Screenshots and voice notes in Cloudflare R2 (D54, D58): the database decides where each file lives.
// temporary (tmp/, expires after 7 days) → kept (kept/, never expires) when an expense that uses it is saved.
model StoredFile {
  id          String    @id @default(cuid())
  userId      String? // whose row it is (P23, D82): set and filtered by the tenancy extension
  channel     String // ExpenseDraftChannel
  storageKey  String    @unique // object key in the bucket (tmp/… or kept/…)
  contentType String
  sizeBytes   Int?
  sha256      String? // same bytes = same file
  status      String    @default("temporary") // StoredFileStatus
  expiresAt   DateTime? // temporary files only
  keptAt      DateTime?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  drafts      ExpenseDraft[]
  attachments Attachment[]

  @@index([status, expiresAt])
  @@index([userId])
  @@map("bot_files")
}

// ==================== EXPENSES (exp_) ====================

// Day-to-day expenses ("gastos sin culpa"): meals, taxi, coffee… paid with cash, wallets or debit.
// Expenses paid with a credit card go to exp_credit_card_expenses.
model DailyExpense {
  id              String        @id @default(cuid())
  userId          String? // whose row it is (P23, D82): set and filtered by the tenancy extension
  description     String
  amount          Float
  othersShare     Float         @default(0) // what other people owe of this expense (shared, D73)
  currency        String        @default("PEN")
  exchangeRate    Float?
  amountInPen     Float?
  expenseType     String        @default("essential")
  spentAt         DateTime
  personId        String
  person          Person        @relation(fields: [personId], references: [id])
  paymentMethodId String
  paymentMethod   PaymentMethod @relation(fields: [paymentMethodId], references: [id])
  categoryId      String?
  category        Category?     @relation(fields: [categoryId], references: [id])
  merchant        String?
  operationNumber String?
  notes           String?
  tripId          String? // the trip that was open when it was saved (/viaje, P18, D128)
  trip            Trip?         @relation(fields: [tripId], references: [id], onDelete: SetNull)
  draftId         String?       @unique
  draft           ExpenseDraft? @relation(fields: [draftId], references: [id])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([spentAt])
  @@index([personId])
  @@index([categoryId])
  @@index([tripId])
  @@index([userId])
  @@map("exp_daily_expenses")
}

// Shared fields: description (concept), amount, currency, exchangeRate, amountInPen,
// expenseType, paymentStatus, personId, categoryId, installment ("n/m"),
// paymentMonth, paymentYear, notes, draftId (the chat draft it came from).

model FixedCost {
  id              String         @id @default(cuid())
  userId          String? // whose row it is (P23, D82): set and filtered by the tenancy extension
  description     String
  amount          Float
  othersShare     Float          @default(0) // what other people owe of this expense (shared, D73)
  currency        String         @default("PEN")
  exchangeRate    Float?
  amountInPen     Float?
  expenseType     String         @default("essential")
  paymentStatus   String         @default("not_started")
  personId        String
  person          Person         @relation(fields: [personId], references: [id])
  categoryId      String
  category        Category       @relation(fields: [categoryId], references: [id])
  paymentMethodId String?
  paymentMethod   PaymentMethod? @relation(fields: [paymentMethodId], references: [id])
  installment     String?
  paymentMonth    Int
  paymentYear     Int
  paymentDate     DateTime?
  dueDate         DateTime?
  attentionDate   DateTime?
  notes           String?
  draftId         String?        @unique
  importKey       String?        @unique // fingerprint of the Notion row it was imported from (P14, D90)
  draft           ExpenseDraft?  @relation(fields: [draftId], references: [id])
  commitmentId    String? // the loan this installment belongs to ("17/48", P27, D99)
  commitment      Commitment?    @relation(fields: [commitmentId], references: [id])
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([paymentMonth, paymentYear])
  @@index([categoryId])
  @@index([personId])
  @@index([paymentStatus])
  @@index([commitmentId])
  @@index([userId])
  @@map("exp_fixed_costs")
}

// Loans and investments (P27, D99). A loan or an investment paid in installments has one fixed cost per installment
// (commitmentId + "n/m"); an investment without installments (bolsa, bitcoin) has contributions
model Commitment {
  id                 String    @id @default(cuid())
  userId             String? // whose row it is (P23, D82): set and filtered by the tenancy extension
  name               String // "BCP", "Terreno San Bartolo", "Bitcoin"
  kind               String // CommitmentKind
  subtype            String // CommitmentSubtype
  entity             String? // the bank or seller
  currency           String    @default("PEN")
  totalAmount        Float? // installmentCount × installmentAmount, or what the asset costs
  installmentCount   Int? // null: no installments (contributions)
  installmentAmount  Float?
  dueDay             Int? // day of the month each installment is due
  startMonth         Int? // month of installment 1
  startYear          Int?
  cancellationAmount Float? // what it costs to cancel it today, edited by hand
  cancellationDate   DateTime? // the day that amount was quoted
  status             String    @default("active") // CommitmentStatus
  personId           String
  person             Person    @relation(fields: [personId], references: [id])
  categoryId         String?
  category           Category? @relation(fields: [categoryId], references: [id])
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  installments  FixedCost[]
  contributions Contribution[]

  @@index([kind, status])
  @@index([userId])
  @@map("exp_commitments")
}

// What you put into an investment without installments: stock purchases, bitcoin (D99)
model Contribution {
  id           String     @id @default(cuid())
  userId       String? // whose row it is (P23, D82): set and filtered by the tenancy extension
  commitmentId String
  commitment   Commitment @relation(fields: [commitmentId], references: [id], onDelete: Cascade)
  date         DateTime
  amount       Float // what you paid
  currency     String     @default("PEN")
  quantity     Float? // 0.0042
  unit         String? // "BTC", "acciones"
  notes        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([commitmentId, date])
  @@index([userId])
  @@map("exp_contributions")
}

// Files of any record (D100): the bytes are in R2 (bot_files), this row says whose they are
model Attachment {
  id        String     @id @default(cuid())
  userId    String? // whose row it is (P23, D82): set and filtered by the tenancy extension
  fileId    String
  file      StoredFile @relation(fields: [fileId], references: [id])
  refType   String // AttachmentRefType
  refId     String
  kind      String // AttachmentKind
  name      String // the name the file had when uploaded
  createdAt DateTime   @default(now())

  @@index([refType, refId])
  @@index([fileId])
  @@index([userId])
  @@map("exp_attachments")
}

// A trip (P18, D128): /viaje <name> tags every day-to-day and card expense saved until /fin. One open at a time
model Trip {
  id        String    @id @default(cuid())
  userId    String? // whose row it is (P23, D82): set and filtered by the tenancy extension
  name      String
  startedAt DateTime  @default(now())
  endedAt   DateTime?
  createdAt DateTime  @default(now())

  dailyExpenses      DailyExpense[]
  creditCardExpenses CreditCardExpense[]

  @@index([userId])
  @@index([endedAt])
  @@map("exp_trips")
}

// What the bot learns (P18, D129): the category / payment method the user chose for a merchant or concept. It fills
// them in the next expense that says the same. No foreign keys: a rule whose category or card was deleted is ignored
model MerchantRule {
  id              String   @id @default(cuid())
  userId          String? // whose row it is (P23, D82): set and filtered by the tenancy extension
  merchant        String // normalized key of the merchant (or, without one, of the description)
  categoryId      String?
  paymentMethodId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, merchant])
  @@index([userId])
  @@map("cat_merchant_rules")
}

model Subscription {
  id              String         @id @default(cuid())
  userId          String? // whose row it is (P23, D82): set and filtered by the tenancy extension
  description     String
  amount          Float
  othersShare     Float          @default(0) // what other people owe of this expense (shared, D73)
  currency        String         @default("PEN")
  exchangeRate    Float?
  amountInPen     Float?
  expenseType     String         @default("essential")
  paymentStatus   String         @default("not_started")
  period          String // SubscriptionPeriod
  kind            String         @default("platform") // SubscriptionKind: Plataformas shows platform, Recurrentes the rest (D107)
  supplyNumber    String? // N.º de suministro of a service (Bitel, Enel)
  personId        String
  person          Person         @relation(fields: [personId], references: [id])
  categoryId      String?
  category        Category?      @relation(fields: [categoryId], references: [id])
  paymentMethodId String?
  paymentMethod   PaymentMethod? @relation(fields: [paymentMethodId], references: [id])
  installment     String?
  paymentMonth    Int
  paymentYear     Int
  paymentDate     DateTime?
  dueDate         DateTime?
  notes           String?
  draftId         String?        @unique
  importKey       String?        @unique // fingerprint of the Notion row it was imported from (P14, D90)
  draft           ExpenseDraft?  @relation(fields: [draftId], references: [id])
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([paymentMonth, paymentYear])
  @@index([personId])
  @@index([kind])
  @@index([userId])
  @@map("exp_subscriptions")
}

model CreditCardExpense {
  id              String        @id @default(cuid())
  userId          String? // whose row it is (P23, D82): set and filtered by the tenancy extension
  description     String
  amount          Float
  othersShare     Float         @default(0) // what other people owe of this expense (shared, D73)
  currency        String        @default("PEN")
  exchangeRate    Float?
  amountInPen     Float?
  expenseType     String        @default("essential")
  paymentStatus   String        @default("pending")
  personId        String
  person          Person        @relation(fields: [personId], references: [id])
  categoryId      String?
  category        Category?     @relation(fields: [categoryId], references: [id])
  paymentMethodId String // a payment method of type credit_card
  paymentMethod   PaymentMethod @relation(fields: [paymentMethodId], references: [id])
  installment     String?
  paymentMonth    Int
  paymentYear     Int
  processDate     DateTime?
  notes           String?
  originDraftId   String? // the draft that also created this row (installments after the first, D73)
  tripId          String? // the trip that was open when it was saved (/viaje, P18, D128)
  trip            Trip?         @relation(fields: [tripId], references: [id], onDelete: SetNull)
  draftId         String?       @unique
  importKey       String?       @unique // fingerprint of the Notion row it was imported from (P14, D90)
  draft           ExpenseDraft? @relation(fields: [draftId], references: [id])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([paymentMethodId, paymentMonth, paymentYear])
  @@index([personId])
  @@index([originDraftId])
  @@index([paymentStatus])
  @@index([tripId])
  @@index([userId])
  @@map("exp_credit_card_expenses")
}

// Loans and debts with people (P17, D38, D60): one row per installment, like the Cuentas board in Notion.
// owed_to_me = someone owes the user; i_owe = the user owes someone. paidAmount is the sum of confirmed payments and
// status follows it (DebtStatus); "late" and "not started" are computed from the payment month, never stored.
model Debt {
  id              String         @id @default(cuid())
  userId          String? // whose row it is (P23, D82): set and filtered by the tenancy extension
  direction       String // DebtDirection
  description     String
  amount          Float // of this installment
  currency        String         @default("PEN")
  exchangeRate    Float?
  amountInPen     Float?
  installment     String? // "n/m"
  paymentMonth    Int
  paymentYear     Int
  dueDate         DateTime?
  status          String         @default("pending") // DebtStatus
  paidAmount      Float          @default(0)
  paidDate        DateTime?
  personId        String
  person          Person         @relation(fields: [personId], references: [id])
  // the card it was charged on (D114): filled from the shared card expense, chosen on manual debts
  paymentMethodId String?
  paymentMethod   PaymentMethod? @relation("DebtCard", fields: [paymentMethodId], references: [id])
  notes           String?
  originDraftId   String? // the draft that also created this row (installments, shared parts, D73)
  draftId         String?        @unique // the chat draft it came from (first installment only)
  importKey       String?        @unique // fingerprint of the Notion row it was imported from (P14, D90)
  draft           ExpenseDraft?  @relation(fields: [draftId], references: [id])
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  payments DebtPayment[]

  @@index([personId, direction, status])
  @@index([paymentYear, paymentMonth])
  @@index([originDraftId])
  @@index([paymentMethodId, paymentYear, paymentMonth])
  @@index([userId])
  @@map("exp_debts")
}

// A payment towards one installment. From the bot it starts as a proposal (confirmedAt null) grouped by batchId,
// until ✅ Confirmar; only confirmed payments count in Debt.paidAmount.
model DebtPayment {
  id              String         @id @default(cuid())
  userId          String? // whose row it is (P23, D82): set and filtered by the tenancy extension
  debtId          String
  debt            Debt           @relation(fields: [debtId], references: [id], onDelete: Cascade)
  amount          Float
  paidAt          DateTime
  paymentMethodId String?
  paymentMethod   PaymentMethod? @relation(fields: [paymentMethodId], references: [id])
  kind            String         @default("payment") // DebtPaymentKind (D114)
  batchId         String? // one message of the bot can pay several installments
  confirmedAt     DateTime?
  notes           String?
  createdAt       DateTime       @default(now())

  @@index([debtId])
  @@index([batchId])
  @@index([userId])
  @@map("exp_debt_payments")
}

model RecurringExpense {
  id              String         @id @default(cuid())
  userId          String? // whose row it is (P23, D82): set and filtered by the tenancy extension
  description     String
  amount          Float
  currency        String         @default("PEN")
  targetType      String // RecurringTargetType
  kind            String         @default("platform") // SubscriptionKind of the rows it generates (D107)
  period          String         @default("monthly") // SubscriptionPeriod
  supplyNumber    String?
  sharedWith      String? // JSON { shares: [{ personId, ratio?, amount? }] }: each month also their cobro (D73, P30)
  expenseType     String         @default("essential")
  personId        String
  person          Person         @relation(fields: [personId], references: [id])
  categoryId      String?
  category        Category?      @relation(fields: [categoryId], references: [id])
  paymentMethodId String?
  paymentMethod   PaymentMethod? @relation(fields: [paymentMethodId], references: [id])
  dayOfMonth      Int
  isActive        Boolean        @default(true)
  lastGeneratedAt DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([userId])
  @@map("exp_recurring_expenses")
}

// ==================== AI USAGE (ai_) ====================
// One row per AI call, used to stay within the free daily quota per provider and model.

model AiRequestLog {
  id           String        @id @default(cuid())
  provider     String // AiProvider
  model        String
  operation    String // AiOperation
  draftId      String?
  draft        ExpenseDraft? @relation(fields: [draftId], references: [id])
  success      Boolean
  errorCode    String?
  inputTokens  Int?
  outputTokens Int?
  latencyMs    Int
  createdAt    DateTime      @default(now())

  @@index([provider, model, createdAt])
  @@map("ai_request_logs")
}

// ==================== NOTIFICATIONS (ntf_) ====================
// Reminders and alerts of P20 (D86, D87): the scheduled jobs create one row per notice; Telegram and the web bell
// deliver it. The rows are the history; Redis only keeps the queues and the lists for the bell.

model Notification {
  id                String    @id @default(cuid())
  userId            String? // whose row it is (P23, D82): set and filtered by the tenancy extension
  kind              String // NotificationKind
  title             String
  body              String
  amount            Float?
  refType           String? // NotificationRefType: what ✅ Pagado and the web link act on
  refId             String?
  eventDate         DateTime? // the day it is about (due date, closing day…), 00:00 UTC
  dedupeKey         String // the same notice is never created twice, even if a job runs again
  readAt            DateTime? // read in the web or answered in Telegram
  telegramChatId    String?
  telegramMessageId String?
  telegramSentAt    DateTime?
  createdAt         DateTime  @default(now())

  @@unique([userId, dedupeKey])
  @@index([readAt])
  @@index([kind, createdAt])
  @@index([userId])
  @@map("ntf_notifications")
}

// Which kinds go to each channel (/avisos, Configuración ▸ Notificaciones). A kind without a row uses the defaults
model NotificationSetting {
  kind      String // NotificationKind
  userId    String // whose row it is (P23, D82): set and filtered by the tenancy extension
  telegram  Boolean
  web       Boolean
  updatedAt DateTime @updatedAt

  @@id([userId, kind])
  @@index([userId])
  @@map("ntf_settings")
}

// ==================== IMPORTS (imp_) ====================
// Bank statements (P14 block 2, D95): one row per statement PDF and one per movement, reconciled with the card
// expenses of that payment month. The PDF itself lives in R2 (fileId, D58).

model Statement {
  id                 String    @id @default(cuid())
  userId             String? // whose row it is (P23, D82): set and filtered by the tenancy extension
  paymentMethodId    String // the card
  personId           String? // person assigned from the PDF or selected before upload
  paymentMonth       Int
  paymentYear        Int
  periodStart        DateTime?
  periodEnd          DateTime?
  dueDate            DateTime? // last day to pay
  totalDue           Float? // total to pay of the statement
  minimumDue         Float?
  previousBalance    Float?    @map("previous_balance")
  previousPayments   Float?    @map("previous_payments")
  monthlyPayment     Float?    @map("monthly_payment")
  minimumAllocations String? // JSON personId -> planned contribution to the minimum payment
  currency           String    @default("PEN")
  source             String // StatementSource: how it was read (template, ai)
  fileId             String?
  status             String    @default("review") // StatementStatus
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  currencyReviewRequired Boolean            @default(false)
  balances               StatementBalance[]
  rows                   StatementRow[]

  @@index([paymentMethodId, paymentYear, paymentMonth])
  @@index([userId])
  @@map("imp_statements")
}

// Shared ISO currency catalog. Statement balances keep their original billing currency.
model CurrencyCatalog {
  code              String             @id
  name              String
  symbol            String
  statementBalances StatementBalance[]

  @@map("cat_currencies")
}

// One bank balance per currency. Never add amounts in PEN and USD together.
model StatementBalance {
  id                 String          @id @default(cuid())
  userId             String?
  statementId        String
  statement          Statement       @relation(fields: [statementId], references: [id], onDelete: Cascade)
  currency           String
  currencyInfo       CurrencyCatalog @relation(fields: [currency], references: [code])
  totalDue           Float?
  minimumDue         Float?
  previousBalance    Float?
  previousPayments   Float?
  monthlyPayment     Float?
  minimumAllocations String?

  @@unique([statementId, currency])
  @@index([userId])
  @@map("imp_statement_balances")
}

model StatementRow {
  id          String    @id @default(cuid())
  userId      String? // whose row it is (P23, D82): set and filtered by the tenancy extension
  statementId String
  statement   Statement @relation(fields: [statementId], references: [id], onDelete: Cascade)
  date        DateTime? // processed day
  description String // as the bank wrote it: never edited, it is what matches a statement with the expenses
  label       String? // your description for it: the name of the expense it creates
  amount      Float
  currency    String    @default("PEN")
  installment String? // "n/m"
  result      String // StatementRowResult: matched, new, created, ignored
  locked      Boolean   @default(false)
  expenseId   String? // the card expense it matched or created
  personId    String? // who made the purchase; null = the statement's person (a card can be used by several people)
  debtId      String? // the cobro created with the expense when the purchase is another person's (D116)
  createdAt   DateTime  @default(now())

  @@index([statementId])
  @@index([userId])
  @@map("imp_statement_rows")
}

// Every Notion import (P14, D90, D104): a preview until it is applied from the web (or make import-notion CONFIRM=yes)
model ImportBatch {
  id        String    @id @default(cuid())
  userId    String? // whose row it is (P23, D82): set and filtered by the tenancy extension
  source    String    @default("notion")
  sourceDir String // folder or uploaded file names
  status    String    @default("preview") // ImportBatchStatus: preview, applied, discarded
  files     Int
  created   Int
  updated   Int // the row changed in Notion since the last import
  unchanged Int // same row as the last import: not touched, so edits made in Kogane stay
  summary   String    @default("{}") // JSON: files read and the month-by-month check against the Notion Resumen
  appliedAt DateTime?
  createdAt DateTime  @default(now())

  rows ImportRow[]

  @@index([status])
  @@index([userId])
  @@map("imp_batches")
}

// One Notion row of a batch: the CSV as it came, what it becomes in Kogane and, once applied, the row it created
model ImportRow {
  id          String      @id @default(cuid())
  userId      String? // whose row it is (P23, D82): set and filtered by the tenancy extension
  batchId     String
  batch       ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  source      String      @default("notion")
  importKey   String? // same as the importKey of the Kogane row (null for issues)
  kind        String      @default("expense") // ImportRowKind: expense, group, budget, issue
  status      String      @default("new") // ImportRowStatus: new, changed, unchanged, blocked, warning
  message     String? // why it is blocked or the warning
  file        String
  line        Int
  base        String? // NotionBase
  targetTable String? // creditCardExpense, fixedCost, subscription, debt, budgetGroup, monthlyBudget
  targetId    String? // set when applied
  destination String? // "Tarjetas ▸ IO · Setiembre 2026": where it goes, for the preview
  description String?
  amount      Float?
  currency    String?
  month       Int?
  year        Int?
  data        String      @default("{}") // JSON of the Kogane row to write
  paidAt      DateTime? // a debt paid in Notion gets one payment of this day
  raw         String // JSON of the CSV row (column → value)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([batchId, kind, status])
  @@index([importKey])
  @@index([targetTable, targetId])
  @@index([userId])
  @@map("imp_rows")
}

// ==================== HISTORY (aud_) ====================

// What changed in the audited tables (P29, D103, D122): written by SQLite triggers in the same transaction as the
// change (scripts/audit-triggers.ts generates them), never by the app. `changes` is JSON: {field: [before, after]}
// for an update, {field: value} for a create or a delete
model AuditChange {
  id        String   @id
  userId    String? // whose row it is (P23, D82): set and filtered by the tenancy extension
  entity    String // the table: exp_fixed_costs
  entityId  String
  action    String // AuditAction
  changes   String
  source    String // AuditSource
  actorId   String? // empty until P23
  batchId   String? // the import that made it
  createdAt DateTime

  @@index([entity, entityId])
  @@index([createdAt])
  @@index([userId])
  @@map("aud_changes")
}

// One row (id = 1): who is writing right now. The triggers read it; each entry point of the app sets it before its
// writes (AuditContextService). The source `import` makes the triggers skip: an import leaves one event (P29)
model AuditContext {
  id      Int     @id
  source  String  @default("cli")
  actorId String?
  batchId String?

  @@map("aud_context")
}

// ==================== USERS (auth_) ====================

// Who signs in (P23, D82–D84): invited by an admin, they enter with Google or with a password. Their data (every row
// with a userId) is theirs alone. The migration creates the owner of the data that existed before (id legacy-owner)
model AuthUser {
  id             String    @id @default(cuid())
  name           String
  email          String    @unique
  googleSub      String?   @unique // the account of Google that signs in as this user
  phone          String?   @unique // digits only (9 in Peru): also signs in with the password; set by an admin, never by the user
  documentNumber String? // DNI: copied to their "Yo" (D94); never returned in the clear
  passwordHash   String? // scrypt: salt.hash
  role           String    @default("member") // UserRole
  status         String    @default("active") // UserStatus
  telegramChatId String?   @unique // the chat linked to this user (D85)
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  sessions AuthSession[]

  @@map("auth_users")
}

// An admin invites an email; whoever opens the link proves it is theirs (there is no way to send mail without a
// domain yet, D91). Only the hash of the token is stored
model AuthInvite {
  id          String    @id @default(cuid())
  email       String
  role        String    @default("member")
  tokenHash   String    @unique
  invitedById String?
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([email])
  @@map("auth_invites")
}

// Opaque session (revocable: a disabled user is out at once); the cookie carries the token, the database its hash
model AuthSession {
  id               String   @id @default(cuid())
  userId           String
  user             AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash        String   @unique
  impersonatedById String? // the superadmin who entered as this user (the backdoor of D84): the history says so
  expiresAt        DateTime
  lastSeenAt       DateTime @default(now())
  createdAt        DateTime @default(now())

  @@index([userId])
  @@map("auth_sessions")
}

// One-use codes: linking a Telegram chat to a user (D85) and the state of a Google sign-in
model AuthToken {
  id        String    @id @default(cuid())
  kind      String // AuthTokenKind
  userId    String?
  tokenHash String    @unique
  payload   String? // JSON
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, kind])
  @@map("auth_tokens")
}

// Failed sign-ins per email, to lock a guess-by-guess attack for a while
model AuthAttempt {
  id        String   @id @default(cuid())
  email     String
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@map("auth_attempts")
}
