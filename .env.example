NODE_ENV="dev"
PORT=5560
LOG_LEVEL=

# Database: local SQLite or Turso
DATABASE_URL="file:./dev.db"
DATABASE_AUTH_TOKEN=

# REST API key used by kogane-app (header x-api-key)
PUBLIC_URL=
API_KEY=

# Login (P23): the web URL (Google sends the browser back to <APP_URL>/api/v1/auth/google/callback) and the
# Google OAuth client (console.cloud.google.com ▸ Credentials ▸ OAuth client ID ▸ Web). Empty: only email + password
APP_URL=http://localhost:4000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The backdoor without a shell (D84): POST /v1/admin/superadmins with this key in the x-admin-key header. Empty: off
ADMIN_BOOTSTRAP_KEY=

# Invitation emails: a Gmail account and its APP PASSWORD (myaccount.google.com/apppasswords, needs 2-step verification),
# not the normal password. Empty: the invitation link is only shown to hand over by hand
SMTP_USER=
SMTP_APP_PASSWORD=
SMTP_FROM_NAME=Kogane

# AI extraction
AI_TIMEOUT_MS=20000
AI_TEXT_PRIMARY=groq
GEMINI_API_KEY=
GEMINI_MODEL_LITE=gemini-3.5-flash-lite
GEMINI_MODEL=gemini-3.5-flash
GEMINI_LITE_DAILY_LIMIT=500
GEMINI_DAILY_LIMIT=20
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_DAILY_LIMIT=1000
GROQ_TRANSCRIBE_MODEL=whisper-large-v3-turbo
GROQ_TRANSCRIBE_DAILY_LIMIT=2000

# Telegram bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_BOT_USERNAME=

# Storage R2
STORAGE_ENV=dev
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=kogane

# Reminders and notifications (P20, D87): Redis for the BullMQ jobs (make redis locally; Railway Redis in production).
# Empty: no scheduled jobs (tests and CI)
REDIS_URL=

# Bank screenshots (P21, D63): local OCR (tesseract.js) before the AI; the Spanish model (~15 MB) is cached here
OCR_ENABLED=true
# OCR_CACHE_DIR=/tmp/kogane-tesseract
